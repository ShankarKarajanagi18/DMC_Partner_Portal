# PORT CONFIGURATION
PORT=3000

# FIREBASE CONFIGURATION
FIREBASE_PROJECT_ID=plan-and-trip-poc
FIREBASE_DATABASE_ID=planandtrippocnative
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# --- Option 1: Fast2SMS (Free India +91 domestic SMS) ---
FAST2SMS_API_KEY=

# --- Option 2: Textbelt Free SMS ---
USE_TEXTBELT_FREE=true
TEXTBELT_API_KEY=textbelt

# --- Option 3: Twilio SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Option 4: MSG91 SMS ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
